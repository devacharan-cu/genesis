{
  "name": "genesis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An experimental self-questioning software intelligence",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "check:docs": "node tools/docs-check.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify": "bash tools/verify-all.sh"
  },
  "devDependencies": {
    "@eslint/js": "9.18.0",
    "@types/node": "22.10.5",
    "@vitest/coverage-v8": "2.1.9",
    "eslint": "9.18.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.20.0",
    "vitest": "2.1.9"
  }
}
