{
  "//": "Typecheck-only configuration. Slice 1 has no runnable app, so nothing is emitted; the emit/project-reference setup lands with apps/cli. See ADR-0002 for why every one of these flags is on.",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "useUnknownInCatchVariables": true,
    "forceConsistentCasingInFileNames": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "noEmit": true,

    "baseUrl": ".",
    "paths": {
      "@genesis/core-types": ["packages/core-types/src/index.ts"],
      "@genesis/blob": ["packages/blob/src/index.ts"],
      "@genesis/identity": ["packages/identity/src/index.ts"],
      "@genesis/secrets": ["packages/secrets/src/index.ts"],
      "@genesis/infrastructure": ["packages/infrastructure/src/index.ts"],
      "@genesis/cloud": ["packages/cloud/src/index.ts"],
      "@genesis/protocol": ["packages/protocol/src/index.ts"],
      "@genesis/ledger": ["packages/ledger/src/index.ts"],
      "@genesis/memory": ["packages/memory/src/index.ts"],
      "@genesis/graph": ["packages/graph/src/index.ts"],
      "@genesis/projections": ["packages/projections/src/index.ts"],
      "@genesis/cognition": ["packages/cognition/src/index.ts"],
      "@genesis/context": ["packages/context/src/index.ts"],
      "@genesis/reasoning": ["packages/reasoning/src/index.ts"],
      "@genesis/sandbox": ["packages/sandbox/src/index.ts"],
      "@genesis/adapters-sandbox-local": ["packages/adapters-sandbox-local/src/index.ts"],
      "@genesis/verification": ["packages/verification/src/index.ts"],
      "@genesis/experiment": ["packages/experiment/src/index.ts"],
      "@genesis/core": ["packages/core/src/index.ts"],
      "@genesis/adapters-aws": ["packages/adapters-aws/src/index.ts"],
      "@genesis/adapters-sqlite": ["packages/adapters-sqlite/src/index.ts"],
      "@genesis/agents": ["packages/agents/src/index.ts"],
      "@genesis/factory": ["packages/factory/src/index.ts"],
      "@genesis/testkit": ["packages/testkit/src/index.ts"]
    }
  },
  "include": ["packages/*/src/**/*.ts", "packages/*/test/**/*.ts", "vitest.config.ts"]
}
