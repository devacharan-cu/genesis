    "@genesis/core-types": "workspace:*",
    "@genesis/graph": "workspace:*",
    "@genesis/ledger": "workspace:*",
    "@genesis/memory": "workspace:*",
    "@genesis/projections": "workspace:*",
    "@genesis/protocol": "workspace:*",
    "@genesis/reasoning": "workspace:*",
    "@genesis/sandbox": "workspace:*",
    "@genesis/verification": "workspace:*",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@genesis/testkit": "workspace:*"
  }
